# 羽衣 RAG 引擎 · 环境配置示例
# 复制为 server/.env 后按需修改（.env 已在 .gitignore 中，不会入库）

# ---------- 服务 ----------
PORT=8787
HOST=0.0.0.0
# 访问令牌：设置后小程序设置页必须填写同样的值；留空表示不校验（仅建议本机调试）
ACCESS_TOKEN=
# 上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# ---------- 大模型（OpenAI 兼容，任选一家） ----------
# DeepSeek（默认，性价比高）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 硅基流动（国内直连，模型选择多）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# 本地 Ollama（需开启 OpenAI 兼容层，地址注意带 /v1）
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama

# ---------- 向量检索（可选，不配置则用 BM25 关键词检索） ----------
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-m3

# ---------- 检索与切片默认值（助手/知识库里可覆盖） ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.15
# 混合检索中 BM25 的权重：1=纯关键词，0=纯向量
RETRIEVAL_ALPHA=0.5
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- HTTPS（可选，配置后小程序真机可直连） ----------
# SSL_KEY_PATH=./server/server.key
# SSL_CERT_PATH=./server/server.crt
