<view class="page-wrap">
  <view class="hero">
    <view class="hero__title">会话记录</view>
    <view class="hero__desc">助手：{{assistantName}} · 会话保存在知识库引擎里，换设备也能取回</view>
  </view>

  <view wx:if="{{loading}}" class="empty">
    <view class="spinner"></view>
    <view class="empty__text">正在读取会话…</view>
  </view>

  <view wx:elif="{{error}}" class="empty">
    <view class="empty__icon">!</view>
    <view class="empty__text">{{error}}</view>
    <view class="btn btn--primary btn--sm" bindtap="onGoAssistant">去选择助手</view>
  </view>

  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty__icon">☰</view>
    <view class="empty__text">还没有会话记录</view>
    <view class="btn btn--primary btn--sm" bindtap="onNewSession">开始一次问答</view>
  </view>

  <block wx:else>
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card card--pad item {{item.id === currentSessionId ? 'item--current' : ''}}"
      data-id="{{item.id}}"
      bindtap="onOpen"
      bindlongpress="onLongPress"
      hover-class="item--hover"
    >
      <view class="item__head">
        <view class="item__name">
          {{item.name}}
          <text wx:if="{{item.id === currentSessionId}}" class="item__badge">进行中</text>
        </view>
        <view class="chevron"></view>
      </view>
      <view wx:if="{{item.preview}}" class="item__preview">{{item.preview}}</view>
      <view class="item__meta">
        <text>{{item.messageCount}} 条消息</text>
        <text>{{item.timeText}}</text>
      </view>
    </view>
    <view class="hint">点会话载入到问答页继续，长按删除</view>
  </block>
</view>

<view class="fab" bindtap="onNewSession" hover-class="fab--hover">
  <view class="fab__plus"></view>
</view>
