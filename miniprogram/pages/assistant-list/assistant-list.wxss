page {
  background: #0b0e1a;
}

.hero {
  margin: 0 -28rpx 24rpx;
  padding: 28rpx 28rpx 32rpx;
  background: linear-gradient(160deg, #241b52 0%, #123047 100%);
  border-bottom: 2rpx solid var(--line);
}

.hero__title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--text-1);
}

.hero__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-3);
}

.empty__sub {
  font-size: 24rpx;
  color: var(--text-4);
}

/* ============================================================
 * 助手卡片
 * ============================================================ */

.item {
  margin-bottom: 20rpx;
}

.item--hover {
  background: var(--surface-2);
}

.item--current {
  border-color: var(--brand-line);
  box-shadow: 0 0 0 2rpx rgba(124, 92, 255, 0.18);
}

.item__head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.item__avatar {
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #0b0e1a;
  background: linear-gradient(135deg, #5b6cff, #8b5cf6);
}

.item__info {
  flex: 1;
  min-width: 0;
}

.item__name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.item__badge {
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 400;
  color: #9db4ff;
  background: rgba(34, 211, 238, 0.12);
  border: 2rpx solid rgba(34, 211, 238, 0.3);
}

.item__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.item__edit {
  flex: none;
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  color: var(--text-2);
  background: var(--surface-2);
  border: 2rpx solid var(--line);
}

.item__desc {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-3);
}

.item__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

/* 助手卡片头像：白底品牌图 */
.item__avatar {
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.34);
}
